# Default provider: local OmniRoute docker (OpenAI-compatible).
# The omniroute container already runs; the lab key is minted in its DB as `pydantic-ai-lab`.
# OMNIROUTE_API_KEY=sk-...
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# PYDANTIC_AI_MODEL=opencode/big-pickle
# Alternative model on the same provider:
# PYDANTIC_AI_MODEL=opencode/space-bunny-free
# Optional: keyed general search engines join the rotation last
# (order: DuckDuckGo keyless+paced -> SearXNG keyless docker -> Exa/Brave if keyed).
# SEARXNG_BASE_URL=http://127.0.0.1:8090
# EXA_API_KEY=...
# BRAVE_API_KEY=...
# Explicit offline mode (no key needed):
# PYDANTIC_AI_MODEL=test
# Paused: Vercel Pixel Canary (gateway 403s without a credit card on file).
# Get a key: `npx vercel ai-gateway setup`
# AI_GATEWAY_API_KEY=...
# PYDANTIC_AI_MODEL=stealth/pixel-canary
# Silence the pydantic-ai banner:
# PYDANTIC_AI_NO_BANNER=1
